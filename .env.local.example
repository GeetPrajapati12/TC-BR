# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (required)
# Get a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/qa-tool?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Strong random secret for signing JWTs (required)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# ─── AI Generation ────────────────────────────────────────────────────────────
# Google Gemini API key (optional — smart fallback is used when absent)
# Get a free key at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
